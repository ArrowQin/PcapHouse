# PcapHouse docker-compose configuration.
#
# Copy this file to ``.env`` (``cp .env.example .env``) and edit as
# needed. docker-compose auto-loads ``.env`` from the project directory.
# Every variable has a default, so the file is entirely optional.

# ----------------------------------------------------------------------
# Where persistent state lives on the HOST.
#
# Two subdirectories are created under this path and bind-mounted into
# the container:
#   ${PCAPHOUSE_DATA_DIR}/db        → /app/db       (SQLite DB + WAL/SHM)
#   ${PCAPHOUSE_DATA_DIR}/uploads   → /app/uploads  (uploaded / generated pcaps)
#
# Default (unset) is ./data, i.e. a ``data/`` folder next to this repo.
# Examples:
#   PCAPHOUSE_DATA_DIR=./data                    # default, inside the repo
#   PCAPHOUSE_DATA_DIR=/srv/pcaphouse            # dedicated data disk
#   PCAPHOUSE_DATA_DIR=/mnt/storage/pcaphouse    # NAS mount, etc.
#
# Tip: absolute paths are clearer on production hosts; relative paths
# are resolved against the directory containing docker-compose.yml.
# ----------------------------------------------------------------------
# PCAPHOUSE_DATA_DIR=./data

# ----------------------------------------------------------------------
# Host port to publish the web UI on. Inside the container nginx always
# listens on :80; this only changes the host-side mapping. Change this
# if 8080 is already in use.
# ----------------------------------------------------------------------
# PCAPHOUSE_HTTP_PORT=8080
